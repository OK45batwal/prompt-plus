# Prompt+ environment reference.
# Copy to `.env.local` for local work. Never commit real values.
# `npm run check-env` validates the required entries for a production deploy.

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL. Runtime uses the Neon HTTP adapter; migrations use the same URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session signing. 32+ characters. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Encrypts provider API keys at rest. 32+ characters, different from AUTH_SECRET.
ENCRYPTION_KEY=""

# Public origin used in emails, sitemap, and CSRF checks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Authentication (optional providers) ─────────────────────────────────────
# GitHub / Google OAuth. Leave both halves empty to disable a provider.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Legacy Auth.js v4 names. AUTH_SECRET/AUTH_URL are preferred.
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL=""

# ── Distributed rate limiting (required in production) ──────────────────────
# Either pair works; the Vercel Upstash integration injects the KV_* pair.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# ── Email (one provider) ────────────────────────────────────────────────────
# SMTP takes precedence over Resend.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Required for real deliveries; defaults to SMTP_USER.
SMTP_FROM="Prompt+ <no-reply@example.com>"
RESEND_API_KEY=""

# ── Operator provider keys (optional) ───────────────────────────────────────
# Used only by the public extension demo and for models that cannot bill a user.
# User-supplied keys are stored per account; these are not a fallback for them.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
GOOGLE_API_KEY=""
NVIDIA_API_KEY=""

# ── Request boundaries ──────────────────────────────────────────────────────
# Extra browser origins allowed to make state-changing calls (comma-separated).
TRUSTED_ORIGINS=""
# Chrome extension ids allowed to call the API (comma-separated).
EXTENSION_ORIGINS=""
# Header set by your proxy when it is not Vercel's x-vercel-forwarded-for.
TRUSTED_PROXY_IP_HEADER=""

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=""
